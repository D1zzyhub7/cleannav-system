<launch>
  <arg name="skeleton_enabled" default="false" />
  <arg name="legacy_input_topic" default="/vehicle_cmd_legacy" />
  <arg name="output_vehicle_cmd_topic" default="/vehicle_cmd" />
  <node pkg="j6m_vehicle_gateway_ros1" type="j6m_vehicle_gateway_ros1_node"
        name="j6m_vehicle_gateway_ros1" output="screen">
    <param name="skeleton_enabled" value="$(arg skeleton_enabled)" />
    <param name="legacy_input_topic" value="$(arg legacy_input_topic)" />
    <param name="output_vehicle_cmd_topic" value="$(arg output_vehicle_cmd_topic)" />
  </node>
</launch>
